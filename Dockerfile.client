FROM node:20-alpine AS builder

WORKDIR /app

COPY client/package*.json ./
RUN npm install

COPY client/ .

# Build with empty VITE_API_URL so the frontend uses relative paths
# (nginx reverse proxy handles routing /api/* and /socket.io/* to the backend)
ENV VITE_API_URL=""
RUN npm run build

# Production stage - serve with nginx
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]